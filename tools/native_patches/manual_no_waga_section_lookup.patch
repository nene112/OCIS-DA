index 0000000..fc7b709
--- /dev/null
+++ b/src/cross_section_lookup.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+
+// Immutable open-channel geometry. A and I are integrals of interpolated T,
+// so the storage derivative used by Newton iteration is exactly dA/dh = T.
+struct SectionHydraulics {
+  double area = 0, top_width = 0, perimeter = 0, pressure_integral = 0;
+};
+
+class CrossSectionLookup {
+public:
+  struct Row { double h, area, width, perimeter, pressure; };
+  std::vector<Row> rows;
+  explicit CrossSectionLookup(std::vector<Row> input) : rows(std::move(input)) {
+    if (rows.size() < 2 || rows.front().h != 0 || rows.front().area != 0
+        || rows.front().pressure != 0) throw std::invalid_argument("invalid section table origin");
+    for (size_t i = 0; i < rows.size(); ++i) {
+      const auto& r = rows[i];
+      if (!std::isfinite(r.h) || !std::isfinite(r.area) || !std::isfinite(r.width)
+          || !std::isfinite(r.perimeter) || !std::isfinite(r.pressure)
+          || r.h < 0 || r.area < 0 || r.width < 0 || r.perimeter < 0 || r.pressure < 0)
+        throw std::invalid_argument("nonfinite or negative section table value");
+      if (!i) continue;
+      const auto& p = rows[i-1];
+      double d = r.h-p.h;
+      if (d <= 0 || r.area <= p.area || r.perimeter < p.perimeter || r.width <= 0)
+        throw std::invalid_argument("nonmonotone section table");
+      double area = p.area + (p.width+r.width)*d/2;
+      double pressure = p.pressure + p.area*d + p.width*d*d/2
+          + (r.width-p.width)*d*d/6;
+      if (std::abs(area-r.area) > 1e-8*(std::max)(1.0, area)
+          || std::abs(pressure-r.pressure) > 1e-8*(std::max)(1.0, pressure))
+        throw std::invalid_argument("section A/T/pressure are inconsistent");
+    }
+    if (rows.back().width <= 0) throw std::invalid_argument("closed/zero-width section unsupported");
+  }
+  SectionHydraulics at(double depth) const {
+    if (!std::isfinite(depth)) throw std::invalid_argument("nonfinite section depth");
+    double h = (std::max)(0.0, depth);
+    if (h >= rows.back().h) {
+      const auto& p = rows.back(); double d = h-p.h;
+      // Explicit vertical-wall extension above the surveyed/generated bank.
+      return {p.area+p.width*d, p.width, p.perimeter+2*d,
+              p.pressure+p.area*d+p.width*d*d/2};
+    }
+    auto upper = std::upper_bound(rows.begin(), rows.end(), h,
+        [](double v, const Row& r) { return v < r.h; });
+    const auto& p = *(upper-1); const auto& q = *upper;
+    double d = h-p.h, slope = (q.width-p.width)/(q.h-p.h);
+    return {p.area+p.width*d+slope*d*d/2, p.width+slope*d,
+            p.perimeter+(q.perimeter-p.perimeter)*d/(q.h-p.h),
+            p.pressure+p.area*d+p.width*d*d/2+slope*d*d*d/6};
+  }
+  double depth_at_area(double area) const {
+    if (!std::isfinite(area) || area < 0) throw std::invalid_argument("invalid section area");
+    if (area >= rows.back().area)
+      return rows.back().h+(area-rows.back().area)/rows.back().width;
+    auto upper = std::upper_bound(rows.begin(), rows.end(), area,
+        [](double v, const Row& r) { return v < r.area; });
+    double lo = (upper-1)->h, hi = upper->h;
+    for (int i=0; i<50; ++i) { double mid=(lo+hi)/2;
+      if (at(mid).area < area) lo=mid; else hi=mid; }
+    return (lo+hi)/2;
+  }
+};
