@@ -0,0 +1,34 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdexcept>
+
+// Heads share one sill datum. Positive discharge leaves the upstream pool.
+inline double TailwaterGateFlow(double opening, double width, double upstream_wh,
+    double downstream_wh, double sill_wh, const std::array<double,4>& mu,
+    bool allow_reverse=true) {
+  if (!std::isfinite(opening)||!std::isfinite(width)||!std::isfinite(upstream_wh)
+      ||!std::isfinite(downstream_wh)||!std::isfinite(sill_wh)||opening<0||width<=0)
+    throw std::invalid_argument("invalid tailwater gate geometry/head");
+  for (double c:mu) if (!std::isfinite(c)||c<0) throw std::invalid_argument("invalid gate coefficient");
+  if (opening==0 || upstream_wh==downstream_wh) return 0;
+  const bool reverse=downstream_wh>upstream_wh;
+  if (reverse&&!allow_reverse) return 0;
+  const double hi=(std::max)(0.,(std::max)(upstream_wh,downstream_wh)-sill_wh);
+  const double lo=(std::max)(0.,(std::min)(upstream_wh,downstream_wh)-sill_wh);
+  if (hi<=0) return 0;
+  auto smooth=[](double x) {x=std::clamp(x,0.,1.);return x*x*(3-2*x);};
+  const double submerged=smooth((lo/hi-.65)/.10);
+  const double e=(std::min)(opening,hi);
+  const double orifice_free=mu[0]*width*e*std::sqrt(19.6*(std::max)(0.,hi-.65*e));
+  const double orifice_sub=mu[1]*width*e*std::sqrt(19.6*(hi-lo));
+  // Full-open free discharge has units L^3/T: b * H^(3/2) * sqrt(g).
+  const double weir_free=mu[2]*width*hi*std::sqrt(19.6*hi);
+  const double weir_sub=mu[3]*width*lo*std::sqrt(19.6*(hi-lo));
+  const double orifice=(1-submerged)*orifice_free+submerged*orifice_sub;
+  const double weir=(1-submerged)*weir_free+submerged*weir_sub;
+  const double full=smooth((opening/hi-.9)/.1);
+  const double flow=(1-full)*orifice+full*weir;
+  return reverse?-flow:flow;
+}
