+void waterSediment::load_cross_section_tables(const nlohmann::json& root, int first, int last) {
+  if (solver_type != "sediment" && solver_type != "Roe_new")
+    throw std::invalid_argument("section lookup requires sediment or Roe_new solver");
+  const auto& features = root.at("features");
+  if (first < 0 || last < first || last >= static_cast<int>(features.size()))
+    throw std::invalid_argument("invalid section feature range");
+  struct Pending { int id; double bottom, slope, height;
+    std::unique_ptr<CrossSectionLookup> table; std::vector<int> nodes; };
+  std::vector<Pending> pending;
+  std::set<int> assigned;
+  nlohmann::json report = {{"format", "ocis_section_tables_v1"}, {"success", false},
+    {"loaded_sections", 0}, {"matched_nodes", 0}, {"unresolved_sections", nlohmann::json::array()},
+    {"sections", nlohmann::json::array()}, {"bed_elevations_preserved", true}};
+  for (int f=first; f<=last; ++f) {
+    const auto& p = features.at(f).at("properties");
+    if (!p.contains("hydraulic_lookup") || p.at("hydraulic_lookup").is_null()) {
+      report["unresolved_sections"].push_back(p.value("Name", std::to_string(f)));
+      continue;
+    }
+    const auto& lookup = p.at("hydraulic_lookup");
+    if (lookup.value("closed", true) || lookup.value("overflow_policy", "") != "vertical_wall_extension")
+      throw std::invalid_argument("unsupported closed section or overflow policy");
+    if (lookup.at("columns") != nlohmann::json::array({"h", "A", "T", "P", "I"}))
+      throw std::invalid_argument("unexpected section table columns");
+    std::vector<CrossSectionLookup::Row> rows;
+    for (const auto& r : lookup.at("rows")) {
+      if (!r.is_array() || r.size()!=5) throw std::invalid_argument("invalid hydraulic table row");
+      rows.push_back({r[0].get<double>(),r[1].get<double>(),r[2].get<double>(),r[3].get<double>(),r[4].get<double>()});
+    }
+    if (rows.empty()) throw std::invalid_argument("empty hydraulic table");
+    Pending item{f+1, p.at("model_bottom_width_m").get<double>(), p.at("model_side_slope").get<double>(),
+      rows.back().h, std::make_unique<CrossSectionLookup>(std::move(rows)), {}};
+    if (!std::isfinite(item.bottom) || !std::isfinite(item.slope) || item.bottom<0 || item.slope<0)
+      throw std::invalid_argument("invalid section dimensions");
+    double start=p.at("chainage_start_m"), end=p.at("chainage_end_m");
+    if (!std::isfinite(start) || !std::isfinite(end) || start<0 || end<=start)
+      throw std::invalid_argument("invalid section chainage");
+    const std::string canal = p.at("model_canal");
+    auto canalIt = canal_id_stake_map.find(canal);
+    if (canalIt == canal_id_stake_map.end()) throw std::invalid_argument("section canal absent from mesh/stake.json");
+    for (int node : p.at("model_node_ids").get<std::vector<int>>()) {
+      auto stakeIt = canalIt->second.find(node);
+      if (node<0 || node>=num || stakeIt==canalIt->second.end()
+          || stakeIt->second < start || stakeIt->second >= end || !assigned.insert(node).second)
+        throw std::invalid_argument("invalid, overlapping or mismatched canal/stake node assignment");
+      // A free-surface profile must never silently replace a closed pipe.
+      if (pt[node].type == eCircular || pt[node].Heit>0)
+        throw std::invalid_argument("open-channel table assigned to closed mesh section");
+      item.nodes.push_back(node);
+    }
+    report["sections"].push_back({{"id", item.id}, {"name",p.value("Name", "")},
+      {"matched_nodes",item.nodes.size()}, {"status",p.value("lookup_status", "ready")}});
+    pending.push_back(std::move(item));
+  }
+  if (assigned.empty()) throw std::invalid_argument("no hydraulic section nodes matched");
+  // Parse/validate every table and association before mutating any node.
+  for (auto& item : pending) {
+    auto* table = item.table.get();
+    section_tables.push_back(std::move(item.table));
+    for (int node : item.nodes) {
+      pt[node].section_lookup=table; pt[node].section_lookup_id=item.id;
+      pt[node].Width=item.bottom; pt[node].tanb=item.slope;
+      pt[node].cosb=1/std::sqrt(1+item.slope*item.slope);
+      pt[node].angle=std::atan(item.slope)*180/pai;
+      pt[node].Height=item.height;
+      UpdateLookupSection(pt[node], HI);
+      pt[node].ux=pt[node].Q/(std::max)(pt[node].A,1e-12);
+    }
+  }
+  // Virtual gate nodes inherit the immutable section of their source node.
+  int inherited=0;
+  for (const auto& v : VWN_originNindex) {
+    int node=v.first, source=v.second;
+    if (node<0 || node>=num || source<0 || source>=num || !pt[source].section_lookup
+        || assigned.count(node)) continue;
+    pt[node].section_lookup=pt[source].section_lookup;
+    pt[node].section_lookup_id=pt[source].section_lookup_id;
+    pt[node].Width=pt[source].Width; pt[node].tanb=pt[source].tanb;
+    pt[node].cosb=pt[source].cosb; pt[node].angle=pt[source].angle;
+    UpdateLookupSection(pt[node], HI); ++inherited;
+  }
+  report["success"]=true; report["loaded_sections"]=pending.size();
+  report["matched_nodes"]=assigned.size(); report["virtual_nodes_inherited"]=inherited;
+  cross_section_import_report=std::move(report);
+}
