+  const double high=experiment(.2,100.9,100);
+  const double reverse=experiment(.2,101.2,100);
+  experiment(.2,100.5,100,true);
+  experiment(.2,101.2,100,true);
+  experiment(.2,100.5,100,false,true);
+  try {experiment(0,101,2,false,true,200.);} catch (const std::runtime_error& error) {
+    require(std::string(error.what()).find("failed to converge")!=std::string::npos,
+            "excessive candidate failed for an unexpected reason");
+    std::cout<<"excessive flow candidate rejected; demand and topology preserved PASS\n";
+  }
+  require(std::abs(closed-900)<1e-8&&std::abs(equal-900)<1e-8,"static lake changed");
+  require(low<high&&high<equal&&reverse>equal,"pool does not respond to prescribed heads");
+  std::cout<<"tailwater boundary: law, sensitivity, closure, datum, reverse, topology, mass PASS\n";
+}
