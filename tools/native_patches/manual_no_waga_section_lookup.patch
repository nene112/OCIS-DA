+#pragma once
+#include "tailwater_gate.h"
+
+double waterSediment::tailwater_stage(const stGate& gate, time_t time) const {
+  auto found=canal_param.boundary_stage2.find(std::string(gate.name));
+  if (found==canal_param.boundary_stage2.end()||found->second.empty())
+    throw std::runtime_error("tailwater stage schedule missing");
+  const auto& samples=found->second;
+  auto right=samples.lower_bound(time);
+  if (right!=samples.end()&&right->first==time) return right->second;
+  if (right==samples.end()||right==samples.begin())
+    throw std::runtime_error("tailwater time outside supplied schedule");
+  auto left=std::prev(right);
+  const double gap=difftime(right->first,left->first);
+  if (gap<=0||gap>gate.BC_max_gap_seconds)
+    throw std::runtime_error("tailwater observation gap exceeds configured limit");
+  return left->second+(right->second-left->second)*difftime(time,left->first)/gap;
+}
+
+void waterSediment::configure_tailwater(const nlohmann::json& config) {
+  if (solver_type!="sediment") throw std::runtime_error("tailwater pool boundary currently requires sediment solver");
+  int id=config.at("gate_id").get<int>();
+  if (!gates||id<0||id>=gatesNum) throw std::invalid_argument("invalid tailwater gate_id");
+  stGate candidate=gates[id];
+  if (!config.value("enabled",true)) {gates[id].BC_STAGE_DOWN_LABEL=0;return;}
+  if (candidate.calculation_type!=1||candidate.nIndexUp<0||candidate.nIndexDown<0
+      ||candidate.nIndex<0||candidate.nIndex>=guassParam.wNodeCount||candidate.nIndexUp>=guassParam.wNodeCount||candidate.nIndexDown>=guassParam.wNodeCount)
+    throw std::invalid_argument("tailwater boundary requires valid opening gate endpoints");
+  candidate.BC_sill_wh=config.at("sill_elevation_m").get<double>();
+  candidate.BC_allow_reverse=config.value("allow_reverse",true);
+  candidate.BC_max_gap_seconds=config.value("max_gap_seconds",21600);
+  if (!std::isfinite(candidate.BC_sill_wh)||candidate.BC_max_gap_seconds<1)
+    throw std::invalid_argument("invalid sill datum or stage gap limit");
+  decltype(canal_param.boundary_stage2)::mapped_type samples;
+  time_t previous=0;bool first=true;
+  for (const auto& sample:config.at("samples")) {
+    time_t time=static_cast<time_t>(sample.at("time").get<long long>());
+    double wh=sample.at("water_level_m").get<double>();
+    if (!std::isfinite(wh)||(!first&&time<=previous)) throw std::invalid_argument("stage samples must be finite and strictly ordered");
+    if (!first&&difftime(time,previous)>candidate.BC_max_gap_seconds)
+      throw std::invalid_argument("stage sample gap exceeds configured limit");
+    samples[time]=wh;previous=time;first=false;
+  }
+  if (samples.size()<2) throw std::invalid_argument("at least two stage samples required");
+  const time_t now=canal_param.start_t+static_cast<time_t>(canal_param.k*step_t);
+  if (samples.begin()->first>now||samples.rbegin()->first<now)
+    throw std::invalid_argument("stage samples must cover current simulation time");
+  candidate.BC_STAGE_DOWN_LABEL=1;
+  candidate.BC_last_flux=0;candidate.BC_out_volume=0;candidate.BC_last_mass_residual=0;candidate.BC_cumulative_mass_residual=0;
+  // Commit only after validating the complete payload; preserve node topology.
+  canal_param.boundary_stage2[std::string(candidate.name)]=std::move(samples);
+  gates[id]=candidate;gates[id].BC_DOWN_wh=tailwater_stage(gates[id],now);
+  tailwater_error.clear();
+}
+
+nlohmann::json waterSediment::tailwater_report() const {
+  nlohmann::json result={{"error",tailwater_error},{"gates",nlohmann::json::array()}};
+  for (int i=0;i<gatesNum;++i) if (gates[i].BC_STAGE_DOWN_LABEL==1) {
+    const auto& g=gates[i];
+    result["gates"].push_back({{"gate_id",i},{"sill_elevation_m",g.BC_sill_wh},
+      {"water_level_m",g.BC_DOWN_wh},{"flux_m3s",g.BC_last_flux},
+      {"capacity_flux_m3s",g.BC_last_capacity},
+      {"net_out_volume_m3",g.BC_out_volume},{"last_mass_residual_m3",g.BC_last_mass_residual},
+      {"cumulative_mass_residual_m3",g.BC_cumulative_mass_residual},
+      {"nIndex",g.nIndex},{"nIndexUp",g.nIndexUp},{"nIndexDown",g.nIndexDown},
+      {"allow_reverse",g.BC_allow_reverse}});
+  }
+  return result;
+}
+
+bool waterSediment::step_tailwater_pool(stGuassParam& param,int k,const std::vector<int>& indices) {
+  std::set<int> pool(indices.begin(),indices.end());int gate_id=-1;
+  for (int j=0;j<gatesNum;++j) if (gates[j].BC_STAGE_DOWN_LABEL==1
+      &&pool.count(gates[j].nIndexUp)&&pool.count(gates[j].nIndex)) {
+    if (gate_id!=-1) throw std::runtime_error("multiple tailwater endpoints in one pool unsupported");
+    gate_id=j;
+  }
+  if (gate_id<0) return false;
+  if (solver_type!="sediment") throw std::runtime_error("unsupported tailwater solver");
+  auto& g=gates[gate_id];auto& up=pt[g.nIndexUp];auto& down=pt[g.nIndexDown];
+  if (up.neighborNodeCount!=2||up.neighborNodes[1]!=g.nIndex||pt[g.nIndex].neighborNodes[1]!=g.nIndexDown)
+    throw std::runtime_error("tailwater boundary is not an ordered gate endpoint");
+  const time_t time=canal_param.start_t+static_cast<time_t>(k*step_t);
+  g.BC_DOWN_wh=tailwater_stage(g,time);
+  // Existing direct turnout stubs also end at external flow boundaries. Do not
+  // evolve their artificial downstream/free-outfall storage as part of this pool.
+  std::vector<int> outlets{gate_id};
+  for (int j=0;j<gatesNum;++j) if (j!=gate_id&&gates[j].calculation_type==0
+      &&gates[j].type==eDam&&pool.count(gates[j].nIndex)&&pool.count(gates[j].nIndexUp)) outlets.push_back(j);
+  std::set<int> excluded;
+  for (int id:outlets) {
+    const auto& outlet=gates[id];
+    if (outlet.nIndexUp<0||outlet.nIndexDown<0||outlet.nIndexDown>=param.wNodeCount
+        ||pt[outlet.nIndexUp].neighborNodeCount!=2||pt[outlet.nIndexUp].neighborNodes[1]!=outlet.nIndex)
+      throw std::runtime_error("invalid direct-flow outlet topology");
+    if (!excluded.insert(outlet.nIndex).second) throw std::runtime_error("overlapping external outlets");
+    int next=outlet.nIndexDown;
+    while (next!=-1&&pool.count(next)) {
+      if (next<0||next>=param.wNodeCount||!excluded.insert(next).second||pt[next].neighborNodeCount!=2)
+        throw std::runtime_error("external ghost chain contains invalid index, junction or cycle");
+      next=pt[next].neighborNodes[1];
+    }
+  }
+  std::vector<int> active;for (int i:indices) if (!excluded.count(i)) active.push_back(i);
+  const std::array<double,4> mu{{g.Uef,g.Ues,g.Ucf,g.Ucs}};
+  double flux=0;
+  auto holes=id_gates_e_map.find(gate_id);
+  if (holes!=id_gates_e_map.end()&&!holes->second.empty()) {
+    for (const auto& hole:holes->second) flux+=TailwaterGateFlow(hole.second,g.Bwid,up.wh,g.BC_DOWN_wh,g.BC_sill_wh,mu,g.BC_allow_reverse);
+  } else flux=(std::max)(1,g.Eopen_num)*TailwaterGateFlow(g.Eopen,g.Bwid,up.wh,g.BC_DOWN_wh,g.BC_sill_wh,mu,g.BC_allow_reverse);
+  // Positivity limit: never discharge more water than the donor cell holds.
+  g.BC_last_capacity=flux;
+  if (flux>0) flux=(std::min)(flux,(std::max)(0.,SectionAtDepth(up,up.h).area-SectionAtDepth(up,HI).area)*up.step_s/step_t);
+  struct OutletState {int id,right,node_gate;eGateType style;int bQ,stage_count;stGateStage stage;double flux;};
+  std::vector<OutletState> saved;
+  double total_out=0;
+  for (int id:outlets) {
+    auto& outlet=gates[id];auto& donor=pt[outlet.nIndexUp];
+    double out=id==gate_id?flux:outlet.stage[0].dQ;
+    if (out>0) out=(std::min)(out,(std::max)(0.,SectionAtDepth(donor,donor.h).area-SectionAtDepth(donor,HI).area)*donor.step_s/step_t);
+    saved.push_back({id,donor.neighborNodes[1],donor.nGateStyleIndex,donor.gateStyle,outlet.bQ,outlet.stageCount,outlet.stage[0],out});
+    total_out+=out;
+  }
+  double before=0;for (int i:active) before+=SectionAtDepth(pt[i],pt[i].h).area*pt[i].step_s;
+  // Reuse the solver's conservative prescribed-flux outlet for this substep.
+  // Only numerical outlet connectivity is temporary; all original gate links are restored.
+  for (const auto& state:saved) {
+    auto& outlet=gates[state.id];auto& donor=pt[outlet.nIndexUp];
+    donor.neighborNodes[1]=-1;donor.gateStyle=eInput;donor.nGateStyleIndex=state.id;
+    outlet.bQ=1;outlet.stageCount=1;outlet.stage[0].dQ=-state.flux;outlet.stage[0].kValue=k;outlet.stage[0].tValue=1;
+  }
+  auto restore=[&] {for (const auto& state:saved) {
+    auto& outlet=gates[state.id];auto& donor=pt[outlet.nIndexUp];
+    donor.neighborNodes[1]=state.right;donor.gateStyle=state.style;donor.nGateStyleIndex=state.node_gate;
+    outlet.bQ=state.bQ;outlet.stage[0]=state.stage;outlet.stageCount=state.stage_count;
+  }};
+  try {SimGuass_sediment_pools(param,k,active);} catch (...) {restore();throw;}
+  restore();
+  if (param.nanLabel||nanLabel) throw std::runtime_error("tailwater pool solver failed");
+  for (int i:active) if (!std::isfinite(pt[i].h)||!std::isfinite(pt[i].Q))
+    throw std::runtime_error("nonfinite tailwater pool state");
+  for (const auto& state:saved) {
+    auto& outlet=gates[state.id];outlet.BC_last_flux=state.flux;
+    outlet.BC_out_volume+=state.flux*step_t;
+    // A direct flow boundary remains a demand, even when the donor cell limits
+    // execution. Do not silently turn the limited flux into the next demand.
+    if (state.id==gate_id) outlet.stage[0].dQ=state.flux;
+    pt[outlet.nIndexDown].Q=state.flux;
+  }
+  // Reservoir/ghost nodes are excluded from pool storage and are not evolved as another reach.
+  g.BC_DOWN_wh=tailwater_stage(g,time+static_cast<time_t>(step_t));
+  down.h=(std::max)(HI,g.BC_DOWN_wh-down.zb);down.wh=down.zb+down.h;
+  const auto shape=SectionAtDepth(down,down.h);
+  down.A=shape.area;down.B=shape.top_width;down.P=shape.perimeter;down.HR=down.P>0?down.A/down.P:0;
+  down.Q=flux;down.ux=down.A>0?flux/down.A:0;down.DetaH=0;
+  double after=0,external_in=0;
+  for (int i:active) {
+    after+=SectionAtDepth(pt[i],pt[i].h).area*pt[i].step_s;
+    if (std::any_of(saved.begin(),saved.end(),[&](const OutletState& state){return gates[state.id].nIndexUp==i;})) continue;
+    if (pt[i].neighborNodeCount==2&&(pt[i].neighborNodes[0]==-1||pt[i].neighborNodes[1]==-1)) {
+      if (pt[i].gateStyle==eInput) external_in+=gates[pt[i].nGateStyleIndex].stage[0].dQ;
+      else external_in+=pt[i].neighborNodes[0]==-1?pt[i].Q:-pt[i].Q;
+    }
+  }
+  g.BC_last_mass_residual=after-before-step_t*(external_in-total_out);
+  g.BC_cumulative_mass_residual+=g.BC_last_mass_residual;
+  return true;
+}
