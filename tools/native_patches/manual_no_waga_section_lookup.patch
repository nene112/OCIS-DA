new file mode 100644
index 0000000..808738f
--- /dev/null
+++ b/tests/cross_section_lookup_test.cpp
@@ -0,0 +1,50 @@
+#include "cross_section_lookup.h"
+#include <iostream>
+
+void close(double a, double b, double tolerance=1e-9) {
+  if (std::abs(a-b)>tolerance) throw std::runtime_error("lookup regression mismatch");
+}
+int main() {
+  try {
+    for (double m : {0.0, 1.0}) {
+      std::vector<CrossSectionLookup::Row> rows;
+      for (int i=0; i<=10; ++i) {
+        double h=i*.3;
+        rows.push_back({h, 2*h+m*h*h, 2+2*m*h, 2+2*h*std::sqrt(1+m*m), h*h+m*h*h*h/3});
+      }
+      CrossSectionLookup table(rows);
+      for (int i=0; i<=300; ++i) {
+        double h=i*.01; auto s=table.at(h);
+        close(s.area, 2*h+m*h*h); close(s.top_width, 2+2*m*h);
+        close(s.perimeter, 2+2*h*std::sqrt(1+m*m));
+        close(s.pressure_integral, h*h+m*h*h*h/3);
+        close(table.depth_at_area(s.area), h);
+      }
+      close(table.depth_at_area(table.at(5).area),5);
+      close(table.at(-1).area,0);
+    }
+    // Circular-bottom U: T starts at zero, and inverse lookup remains stable
+    // near dry bed. Tables use polygonal approximation of the arc.
+    std::vector<CrossSectionLookup::Row> rows{{0,0,0,0,0}};
+    const double r=1.7;
+    for (int i=1; i<=1000; ++i) {
+      double h=r*i/1000, width=2*std::sqrt(2*r*h-h*h);
+      const auto& p=rows.back(); double d=h-p.h;
+      rows.push_back({h,p.area+(p.width+width)*d/2,width,
+        2*r*std::acos(1-h/r),p.pressure+p.area*d+p.width*d*d/2+(width-p.width)*d*d/6});
+    }
+    CrossSectionLookup u(rows);
+    close(u.at(r).area,3.141592653589793*r*r/2,1e-4);
+    close(u.at(r).perimeter,3.141592653589793*r,1e-9);
+    for (double h : {.00001,.1,1.0,1.7,2.4}) close(u.depth_at_area(u.at(h).area),h);
+    // Discrete storage uses A(h)-A(h_old), not T(h)*(h-h_old).
+    close(u.at(1.2).area-u.at(.4).area,
+      u.at(u.depth_at_area(u.at(.4).area+(u.at(1.2).area-u.at(.4).area))).area-u.at(.4).area);
+    bool rejected=false;
+    try { CrossSectionLookup bad({{0,0,2,2,0},{1,99,2,4,1}}); }
+    catch (const std::invalid_argument&) { rejected=true; }
+    if (!rejected) throw std::runtime_error("inconsistent table accepted");
+    std::cout << "PASS rectangle/trapezoid/U, inverse, dry/overflow and inconsistent-table rejection\n";
+    return 0;
+  } catch (const std::exception& e) { std::cerr<<e.what()<<"\n"; return 1; }
+}
